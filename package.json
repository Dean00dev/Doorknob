{
  "name": "doorknob",
  "version": "0.1.0",
  "private": true,
  "description": "A privacy-conscious appointment-brief preparation prototype.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "NODE_ENV=production node server-dist/server/index.js",
    "test": "vitest run",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.116.0",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "helmet": "8.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.0.5",
    "concurrently": "10.0.4",
    "supertest": "7.2.2",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
